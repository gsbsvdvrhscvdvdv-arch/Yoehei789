    <!-- 2. Hero Section -->
    <header class="hero" id="home">
        <div class="container">
            <span class="hero-badge"><i class="fas fa-bolt"></i> Cyberpunk & Esports Festival</span>
            <h1 class="hero-title">
                งานแข่งขันกีฬา & E-Sports
                <span class="neon-text-blue">ฝันดี FEST 2026</span>
            </h1>
            <p style="max-width: 650px; margin: 0 auto; color: var(--text-muted); font-size: 1.1rem;">
                ปลดปล่อยพลังความมันส์ในโลก Cyberpunk ต้อนรับนักเรียน ศิษย์เก่า และคนทั่วไป ร่วมสัมผัสการแข่งขันสุดตื่นเต้น!
            </p>

            <div class="hero-info">
                <div class="hero-info-item">
                    <i class="far fa-calendar-alt"></i>
                    <span>15 พฤศจิกายน 2026</span>
                </div>
                <div class="hero-info-item">
                    <i class="far fa-clock"></i>
                    <span>08:30 - 17:00 น.</span>
                </div>
                <div class="hero-info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>อาคารอเนกประสงค์ โรงเรียนฝันดีวิทยา</span>
                </div>
            </div>

            <div class="hero-btns">
                <a href="#register" class="btn btn-primary"><i class="fas fa-gamepad"></i> เข้าร่วมความสนุก</a>
                <a href="#register" class="btn btn-secondary"><i class="fas fa-file-alt"></i> ดูฟอร์มสมัคร</a>
            </div>
        </div>
    </header>

    <!-- 3. About Section -->
    <section class="about-section" id="about">
        <div class="container">
            <div class="cyber-card">
                <div class="about-grid">
                    <div class="about-text">
                        <span class="neon-text-pink" style="font-weight: 600; text-transform: uppercase;">About The Event</span>
