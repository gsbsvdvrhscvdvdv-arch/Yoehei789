<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ฝันดี | FUNDEE FEST 2026 - งานแข่งขันกีฬา & E-Sports</title>

    <!-- Google Fonts: Kanit & Orbitron for Cyberpunk Look -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================================================
           Cyberpunk Design Variables & Global Styles
           ========================================================================== */
        :root {
            --bg-primary: #070913;
            --bg-secondary: #0d0f1d;
            --bg-card: rgba(16, 20, 38, 0.85);
            --neon-blue: #00f3ff;
            --neon-pink: #ff007f;
            --neon-purple: #9d00ff;
            --text-main: #e2e8f0;
            --text-muted: #94a3b8;
            --border-glow: rgba(0, 243, 255, 0.3);
            --font-main: 'Kanit', sans-serif;
            --font-cyber: 'Orbitron', 'Kanit', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: var(--font-main);
            line-height: 1.6;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(255, 0, 127, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 243, 255, 0.08) 0%, transparent 40%);
        }

        /* Cyberpunk Grid Background Layer */
        .cyber-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(0, 243, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
            pointer-events: none;
            z-index: 0;
        }

        /* Utility Classes & Neon Effects */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 1;
        }

        .neon-text-blue {
            color: var(--neon-blue);
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.7), 0 0 20px rgba(0, 243, 255, 0.4);
        }

        .neon-text-pink {
            color: var(--neon-pink);
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.7), 0 0 20px rgba(255, 0, 127, 0.4);
        }

        .section-title {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-subtitle {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 3rem;
            font-size: 1.05rem;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 28px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            font-family: var(--font-cyber);
            border: 2px solid transparent;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
            color: #fff;
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.5);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.8);
            background: linear-gradient(135deg, #ff1a8c, #aa1aff);
        }

        .btn-secondary {
            background: transparent;
            color: var(--neon-blue);
            border-color: var(--neon-blue);
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.2);
        }

        .btn-secondary:hover {
            background: rgba(0, 243, 255, 0.15);
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.6);
            transform: translateY(-3px);
        }

        /* Cyberpunk Card Base */
        .cyber-card {
            background: var(--bg-card);
            border: 1px solid rgba(0, 243, 255, 0.2);
            border-radius: 12px;
            padding: 30px;
            position: relative;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            clip-path: polygon(
                0 0, 
                calc(100% - 15px) 0, 
                100% 15px, 
                100% 100%, 
                15px 100%, 
                0 calc(100% - 15px)
            );
        }

        .cyber-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
        }

        .cyber-card:hover {
            border-color: var(--neon-blue);
            box-shadow: 0 0 25px rgba(0, 243, 255, 0.3);
            transform: translateY(-5px);
        }

        /* ==========================================================================
           1. Navbar
           ========================================================================== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(7, 9, 19, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 243, 255, 0.2);
            z-index: 1000;
            padding: 15px 0;
        }

        .navbar-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: var(--font-cyber);
            font-size: 1.5rem;
            font-weight: 900;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-sub {
            font-size: 0.85rem;
            background: var(--neon-pink);
            color: #fff;
            padding: 2px 6px;
            border-radius: 3px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            font-weight: 400;
            transition: 0.3s;
            font-size: 0.95rem;
        }

        .nav-links a:hover {
            color: var(--neon-blue);
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.6);
        }

        .hamburger {
            display: none;
            font-size: 1.5rem;
            color: var(--neon-blue);
            cursor: pointer;
        }

        /* ==========================================================================
           2. Hero Section
           ========================================================================== */
        .hero {
            min-height: 100vh;
            padding-top: 130px;
            padding-bottom: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
        }

        .hero-badge {
            display: inline-block;
            padding: 6px 16px;
            background: rgba(255, 0, 127, 0.15);
            border: 1px solid var(--neon-pink);
            border-radius: 20px;
            color: var(--neon-pink);
            font-size: 0.9rem;
            margin-bottom: 20px;
            font-weight: 600;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.3);
        }

        .hero-title {
            font-size: 3.2rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero-title span {
            display: block;
        }

        .hero-info {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin: 25px 0 35px 0;
            color: var(--text-main);
            font-size: 1.1rem;
        }

        .hero-info-item {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(13, 15, 29, 0.8);
            padding: 8px 18px;
            border-radius: 8px;
            border: 1px solid rgba(0, 243, 255, 0.2);
        }

        .hero-info-item i {
            color: var(--neon-blue);
        }

        .hero-btns {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* ==========================================================================
           3. About Section
           ========================================================================== */
        .about-section {
            padding: 80px 0;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .about-text h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: #fff;
        }

        .about-text p {
            color: var(--text-muted);
            margin-bottom: 15px;
            font-size: 1.05rem;
        }

        .about-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 25px;
        }

        .stat-box {
            background: rgba(0, 243, 255, 0.05);
            border: 1px solid rgba(0, 243, 255, 0.2);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-num {
            font-family: var(--font-cyber);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--neon-pink);
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* ==========================================================================
           4. Featured Activities
           ========================================================================== */
        .activities-section {
            padding: 80px 0;
            background: rgba(13, 15, 29, 0.5);
        }

        .activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
        }

        .activity-card {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .activity-icon {
            font-size: 2.8rem;
            color: var(--neon-blue);
            margin-bottom: 20px;
            display: inline-block;
        }

        .activity-card:nth-child(2) .activity-icon {
            color: var(--neon-pink);
        }

        .activity-card:nth-child(3) .activity-icon {
            color: var(--neon-purple);
        }

        .activity-title {
            font-size: 1.4rem;
            margin-bottom: 10px;
            color: #fff;
        }

        .activity-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 20px;
            flex-grow: 1;
        }

        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            font-size: 0.8rem;
            padding: 4px 10px;
            border-radius: 4px;
            background: rgba(0, 243, 255, 0.1);
            color: var(--neon-blue);
            border: 1px solid rgba(0, 243, 255, 0.3);
        }

        .tag-pink {
            background: rgba(255, 0, 127, 0.1);
            color: var(--neon-pink);
            border-color: rgba(255, 0, 127, 0.3);
        }

        /* ==========================================================================
           5. Schedule / Timeline
           ========================================================================== */
        .schedule-section {
            padding: 80px 0;
        }

        .timeline {
            position: relative;
            max-width: 800px;
            margin: 0 auto;
        }

        .timeline::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 2px;
            background: linear-gradient(180deg, var(--neon-blue), var(--neon-pink));
            transform: translateX(-50%);
        }

        .timeline-item {
            margin-bottom: 40px;
            position: relative;
            width: 50%;
        }

        .timeline-item:nth-child(odd) {
            left: 0;
            padding-right: 30px;
            text-align: right;
        }

        .timeline-item:nth-child(even) {
            left: 50%;
            padding-left: 30px;
            text-align: left;
        }

        .timeline-dot {
            position: absolute;
            top: 5px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--bg-primary);
            border: 2px solid var(--neon-blue);
            box-shadow: 0 0 10px var(--neon-blue);
            z-index: 2;
        }

        .timeline-item:nth-child(odd) .timeline-dot {
            right: -8px;
        }

        .timeline-item:nth-child(even) .timeline-dot {
            left: -8px;
            border-color: var(--neon-pink);
            box-shadow: 0 0 10px var(--neon-pink);
        }

        .timeline-content {
            background: var(--bg-card);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .timeline-time {
            font-family: var(--font-cyber);
            font-size: 1.1rem;
            color: var(--neon-blue);
            font-weight: 700;
            margin-bottom: 5px;
        }

        .timeline-item:nth-child(even) .timeline-time {
            color: var(--neon-pink);
        }

        .timeline-title {
            font-size: 1.15rem;
            color: #fff;
            margin-bottom: 5px;
        }

        /* ==========================================================================
           6. Registration Form
           ========================================================================== */
        .register-section {
            padding: 80px 0;
            background: rgba(13, 15, 29, 0.5);
        }

        .form-container {
            max-width: 700px;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            color: #fff;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            background: rgba(7, 9, 19, 0.8);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 6px;
            color: #fff;
            font-family: var(--font-main);
            font-size: 1rem;
            transition: 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--neon-blue);
            box-shadow: 0 0 12px rgba(0, 243, 255, 0.4);
        }

        select.form-control option {
            background: var(--bg-primary);
            color: #fff;
        }

        /* ==========================================================================
           7. Gallery Section
           ========================================================================== */
        .gallery-section {
            padding: 80px 0;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            height: 220px;
            border: 1px solid rgba(0, 243, 255, 0.2);
            cursor: pointer;
        }

        .gallery-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to top, rgba(7, 9, 19, 0.9), transparent);
            display: flex;
            align-items: flex-end;
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .gallery-item:hover .gallery-img {
            transform: scale(1.1);
        }

        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }

        .gallery-caption {
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
        }

        /* ==========================================================================
           8. Contact & Social Media
           ========================================================================== */
        .contact-section {
            padding: 80px 0;
            background: rgba(13, 15, 29, 0.8);
            border-top: 1px solid rgba(0, 243, 255, 0.2);
        }

        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .social-card {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            text-decoration: none;
            color: #fff;
            transition: 0.3s ease;
        }

        .social-card i {
            font-size: 2rem;
        }

        .social-card.facebook i { color: #1877f2; }
        .social-card.instagram i { color: #e4405f; }
        .social-card.discord i { color: #5865f2; }
        .social-card.tiktok i { color: #00f2fe; }

        .social-card:hover {
            transform: translateY(-5px);
            border-color: var(--neon-blue);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
        }

        /* ==========================================================================
           9. Modal Popup
           ========================================================================== */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-box {
            background: var(--bg-secondary);
            border: 2px solid var(--neon-blue);
            box-shadow: 0 0 30px rgba(0, 243, 255, 0.4);
            border-radius: 12px;
            padding: 35px;
            max-width: 450px;
            width: 90%;
            text-align: center;
            transform: scale(0.8);
            transition: transform 0.3s ease;
        }

        .modal-overlay.active .modal-box {
            transform: scale(1);
        }

        .modal-icon {
            font-size: 3.5rem;
            color: var(--neon-blue);
            margin-bottom: 15px;
        }

        /* ==========================================================================
           10. Footer
           ========================================================================== */
        footer {
            padding: 30px 0;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Responsive Breakpoints */
        @media (max-width: 768px) {
            .hamburger {
                display: block;
            }

            .nav-links {
                position: fixed;
                top: 70px;
                left: -100%;
                width: 100%;
                height: calc(100vh - 70px);
                background: rgba(7, 9, 19, 0.98);
                flex-direction: column;
                padding: 40px 0;
                transition: 0.4s ease;
            }

            .nav-links.active {
                left: 0;
            }

            .hero-title {
                font-size: 2.2rem;
            }

            .about-grid {
                grid-template-columns: 1fr;
            }

            .timeline::before {
                left: 20px;
            }

            .timeline-item {
                width: 100%;
                padding-left: 50px !important;
                padding-right: 0 !important;
                text-align: left !important;
            }

            .timeline-item:nth-child(odd) .timeline-dot,
            .timeline-item:nth-child(even) .timeline-dot {
                left: 12px;
            }
        }
    </style>
</head>
<body>

    <!-- Cyber Background Grid Pattern -->
    <div class="cyber-grid"></div>

    <!-- 1. Navbar -->
    <nav class="navbar">
        <div class="container navbar-container">
            <a href="#" class="logo neon-text-blue">
                ฝันดี <span class="logo-sub">FEST 2026</span>
            </a>
            
            <div class="hamburger" id="hamburgerBtn">
                <i class="fas fa-bars"></i>
